+            case .missionControl: return traits.userInterfaceStyle == .dark
+                ? UIColor(red: 0.035, green: 0.085, blue: 0.095, alpha: 1)
+                : UIColor(red: 0.94, green: 0.98, blue: 0.98, alpha: 1)
+            case .eclipse: return .secondarySystemBackground
+            }
+        }
+    }
+
+    public var cornerRadius: CGFloat {
+        switch self {
+        case .original: return 0
+        case .orbit: return 22
+        case .missionControl: return 10
+        case .eclipse: return 16
+        }
+    }
+}
