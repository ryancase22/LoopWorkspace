+                + tableView.rectForFooter(inSection: section.rawValue).height
+        })
+        let budget = cardHeightBudget
+        guard lastCardHeightBudget != budget else { return }
+        lastCardHeightBudget = budget
+        tableView.beginUpdates()
+        tableView.endUpdates()
+    }
