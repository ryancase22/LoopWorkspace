+                let occupied: CGFloat = 59 + 83 + 90 + 84 + 20
+                let budget = viewport - occupied
+                let rows = layout.fittedChartHeights(availableHeight: budget)
+                XCTAssertEqual(rows.count, 4)
+                XCTAssertEqual(rows.reduce(0, +), budget, accuracy: 0.01)
+                XCTAssertLessThanOrEqual(rows.reduce(0, +) + occupied, viewport)
