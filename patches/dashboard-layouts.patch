+        let colors = [accent.withAlphaComponent(0.20).cgColor, UIColor.clear.cgColor] as CFArray
+        if let gradient = CGGradient(colorsSpace: CGColorSpaceCreateDeviceRGB(), colors: colors, locations: [0, 1]) {
+            context.drawRadialGradient(gradient, startCenter: CGPoint(x: rect.width * 0.85, y: rect.height),
+                startRadius: 0, endCenter: CGPoint(x: rect.width * 0.85, y: rect.height),
+                endRadius: rect.width * 0.9, options: [])
+        }
+        context.setStrokeColor(accent.withAlphaComponent(0.35).cgColor)
+        context.setLineWidth(1)
+        context.strokeEllipse(in: CGRect(x: rect.width * 0.35, y: rect.height * 0.60,
+                                         width: rect.width, height: rect.width * 0.45))
+        if traitCollection.userInterfaceStyle == .dark,
+           let image = UIImage(named: "DashboardHorizon", in: .main, compatibleWith: traitCollection) {
+            image.draw(in: rect, blendMode: .normal, alpha: 0.25)
+        }
+        context.restoreGState()
+    }
