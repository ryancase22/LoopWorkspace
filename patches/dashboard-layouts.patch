+// Local presentation preference only; deliberately separate from therapy settings.
+enum DashboardLayout: String, CaseIterable {
+    case original, glance, graphFirst, compact, aurora, telemetry, zenith
+
+    static let preferenceKey = "com.ryancase.loop.dashboardLayout.v1"
+
+    static var selected: DashboardLayout {
+        DashboardLayout(rawValue: UserDefaults.standard.string(forKey: preferenceKey) ?? "") ?? .original
+    }
+
+    // Allocate one finite viewport budget. Do not independently clamp each row,
+    // which made the previous cards taller than the screen in total.
+    func fittedChartHeights(availableHeight: CGFloat, cards: [DashboardCard] = DashboardCard.allCases) -> [CGFloat] {
+        let weights: [CGFloat]
+        switch self {
+        case .original, .glance: weights = [0.40, 0.20, 0.20, 0.20]
+        case .graphFirst: weights = [0.46, 0.18, 0.18, 0.18]
+        case .compact: weights = [0.34, 0.22, 0.22, 0.22]
+        case .aurora: weights = [0.37, 0.21, 0.21, 0.21]
+        case .telemetry: weights = [0.32, 0.24, 0.26, 0.18]
+        case .zenith: weights = [0.40, 0.20, 0.20, 0.20]
+        }
+        guard !cards.isEmpty else { return [] }
+        let budget = max(0, availableHeight)
+        let total = cards.reduce(CGFloat(0)) { $0 + weights[$1.rawValue] }
+        let first = cards.dropLast().map { floor(budget * weights[$0.rawValue] / total) }
+        return first + [max(0, budget - first.reduce(0, +))]
+    }
+
+    var presentation: DashboardPresentation {
+        switch self {
+        case .original: return .original
+        case .glance: return .orbit
+        case .graphFirst: return .missionControl
+        case .compact: return .eclipse
+        case .aurora: return .aurora
+        case .telemetry: return .telemetry
+        case .zenith: return .zenith
+        }
+    }
+
+    var title: String {
+        switch self {
+        case .original: return "Original Loop"
+        case .glance: return "Everyday cards"
+        case .graphFirst: return "Glucose focus"
+        case .compact: return "Simple cards"
+        case .aurora: return "Compact cards"
+        case .telemetry: return "Insulin focus"
+        case .zenith: return "Large numbers"
+        }
+    }
+
+    var detail: String {
+        switch self {
+        case .original: return "The standard Loop dashboard."
+        case .glance: return "Balanced cards."
+        case .graphFirst: return "Larger glucose graph."
+        case .compact: return "Minimal cards."
+        case .aurora: return "Compact cards."
+        case .telemetry: return "Larger insulin graphs."
+        case .zenith: return "Larger glucose number."
+        }
+    }
+}
+
+/// Display preferences only. Glucose cannot be hidden; invalid stored values recover safely.
+enum DashboardCard: Int, CaseIterable {
+    case glucose, iob, dose, cob
+    static let orderKey = "com.ryancase.loop.dashboardCardOrder.v1"
+    static let hiddenKey = "com.ryancase.loop.dashboardHiddenCards.v1"
+    static let podCountdownKey = "com.ryancase.loop.podCountdown.v1"
+
+    var title: String {
+        switch self {
+        case .glucose: return "Glucose"
+        case .iob: return "Active Insulin"
+        case .dose: return "Insulin Delivery"
+        case .cob: return "Active Carbohydrates"
+        }
+    }
+
+    static func ordered(from value: String) -> [DashboardCard] {
+        let stored = value.split(separator: ",").compactMap { Int($0) }.compactMap(Self.init(rawValue:))
+        return (stored + allCases).reduce(into: []) { result, card in
+            if !result.contains(card) { result.append(card) }
+        }
+    }
+
+    static func hidden(from value: String) -> Set<DashboardCard> {
+        Set(value.split(separator: ",").compactMap { Int($0) }.compactMap(Self.init(rawValue:)).filter { $0 != .glucose })
+    }
+
+    static var selected: [DashboardCard] {
+        let defaults = UserDefaults.standard
+        let hidden = hidden(from: defaults.string(forKey: hiddenKey) ?? "")
+        return ordered(from: defaults.string(forKey: orderKey) ?? "").filter { !hidden.contains($0) }
+    }
+}
+
+/// Uses the current pod's recorded nominal expiry only. Never guesses from a progress bar.
+enum DashboardPodStatus {
+    static func expiration(managerIdentifier: String?, rawState: [String: Any]) -> Date? {
+        guard managerIdentifier == "Omni",
+              let pod = rawState["podState"] as? [String: Any],
+              pod["fault"] == nil,
+              pod["deliveryStoppedAt"] == nil,
+              pod["setupProgress"] as? Int == 8, // Omni SetupProgress.completed at the pinned revision
+              let expiration = pod["expiresAt"] as? Date else { return nil }
+        return expiration
+    }
+}
+
+/// Display-only date exported by the current G7 manager, using its own session lifetime.
+enum DashboardDexcomStatus {
+    static func expiration(managerIdentifier: String?, rawState: [String: Any]) -> Date? {
+        guard managerIdentifier == "G7CGMManager",
+              let sensorID = rawState["sensorID"] as? String, !sensorID.isEmpty,
+              rawState["activatedAt"] is Date,
+              let expiration = rawState["dashboardSensorExpiresAt"] as? Date,
+              expiration.timeIntervalSinceReferenceDate.isFinite else { return nil }
+        return expiration
+    }
+}
