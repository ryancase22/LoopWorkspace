+
+    private var cardHeightBudget: CGFloat {
+        let viewport = tableView.bounds.height - tableView.adjustedContentInset.top - tableView.adjustedContentInset.bottom
+        var occupied: CGFloat = (tableView.tableHeaderView?.bounds.height ?? 0) + (tableView.tableFooterView?.bounds.height ?? 0)
+        for section in [Section.alertWarning, .hud, .status] {
+            let cells = tableView.visibleCells.filter {
+                tableView.indexPath(for: $0)?.section == section.rawValue
+            }
+            if !cells.isEmpty {
+                occupied += cells.reduce(0) { $0 + $1.bounds.height }
+            } else {
+                switch section {
+                case .hud: occupied += shouldShowHUD ? 90 : 0
+                case .status: occupied += shouldShowStatus ? 84 : 0
+                case .alertWarning: occupied += shouldShowBannerWarning ? 100 : 0
+                case .charts: break
+                }
+            }
+        }
+        // Leave breathing room above the bottom controls and for fractional row rounding.
+        return floor(max(0, viewport - occupied - cardSectionChrome - 20))
+    }
+
+    override func viewDidLayoutSubviews() {
