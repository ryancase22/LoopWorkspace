+
+// Local presentation preference only; deliberately separate from therapy settings.
+enum DashboardLayout: String, CaseIterable {
+    case original, glance, graphFirst, compact
+
+    static let preferenceKey = "com.ryancase.loop.dashboardLayout.v1"
+
+    static var selected: DashboardLayout {
+        DashboardLayout(rawValue: UserDefaults.standard.string(forKey: preferenceKey) ?? "") ?? .original
+    }
+
+    var title: String {
+        switch self {
+        case .original: return "Original Loop"
+        case .glance: return "Glance"
+        case .graphFirst: return "Graph first"
+        case .compact: return "Compact"
+        }
+    }
+
+    var detail: String {
+        switch self {
+        case .original: return "The standard Loop dashboard."
+        case .glance: return "Larger glucose text above pump and Loop status."
+        case .graphFirst: return "More space for glucose history and prediction."
+        case .compact: return "Shorter charts with every chart still available."
+        }
+    }
+}
diff --git a/Loop/LoopTests/LoopTests.swift b/Loop/LoopTests/LoopTests.swift
index b29b1d5..7582ec1 100644
--- a/Loop/LoopTests/LoopTests.swift
+++ b/Loop/LoopTests/LoopTests.swift
@@ -7,10 +7,94 @@
 //
 
 import XCTest
+import UIKit
+import HealthKit
+import LoopUI
 
 @testable import Loop
 
-class LoopTests: XCTestCase {}
+class LoopTests: XCTestCase {
+    func testDashboardPreferenceDefaultsAndRoundTrip() {
+        let defaults = UserDefaults.standard
+        let key = DashboardLayout.preferenceKey
+        let previous = defaults.object(forKey: key)
+        defer {
+            if let previous = previous { defaults.set(previous, forKey: key) }
+            else { defaults.removeObject(forKey: key) }
+        }
+        defaults.removeObject(forKey: key)
+        XCTAssertEqual(DashboardLayout.selected, .original)
+        defaults.set("unknown-future-layout", forKey: key)
+        XCTAssertEqual(DashboardLayout.selected, .original)
+        for layout in DashboardLayout.allCases {
+            defaults.set(layout.rawValue, forKey: key)
+            XCTAssertEqual(DashboardLayout.selected, layout)
+        }
+    }
+
+    @MainActor
+    func testGlanceRetainsHUDsAndRestoresOriginalLayout() {
+        let hud = StatusBarHUDView(frame: CGRect(x: 0, y: 0, width: 390, height: 74))
+        let cgm = hud.cgmStatusHUD!
+        let pump = hud.pumpStatusHUD!
+        let loop = hud.loopCompletionHUD!
+        let originalFont = cgm.glucoseValueHUD.glucoseLabel.font
+        let originalSpacing = hud.containerView.spacing
+        let tap = UITapGestureRecognizer()
+        cgm.addGestureRecognizer(tap)
+
+        // An old reading must remain stale through every presentation change.
+        cgm.setGlucoseQuantity(112, at: Date().addingTimeInterval(-3600),
+                              unit: HKUnit(from: "mg/dL"), staleGlucoseAge: 600,
+                              glucoseDisplay: nil, wasUserEntered: false, isDisplayOnly: false)
+        let staleText = cgm.glucoseValueHUD.glucoseLabel.text
+        XCTAssertNotEqual(staleText, "112")
+        for _ in 0..<3 {
+            hud.setGlanceLayout(true)
+            hud.setGlanceLayout(true)
+            XCTAssertTrue(hud.cgmStatusHUD === cgm)
+            XCTAssertTrue(hud.pumpStatusHUD === pump)
+            XCTAssertTrue(hud.loopCompletionHUD === loop)
+            XCTAssertEqual(hud.containerView.axis, .vertical)
+            XCTAssertTrue(cgm.gestureRecognizers?.contains(tap) == true)
+            XCTAssertEqual(cgm.glucoseValueHUD.glucoseLabel.text, staleText)
+            hud.setGlanceLayout(false)
+            XCTAssertEqual(hud.containerView.axis, .horizontal)
+            XCTAssertEqual(hud.containerView.arrangedSubviews.count, 3)
+            XCTAssertTrue(hud.containerView.arrangedSubviews[0] === cgm)
+            XCTAssertTrue(hud.containerView.arrangedSubviews[1] === loop)
+            XCTAssertTrue(hud.containerView.arrangedSubviews[2] === pump)
+            XCTAssertEqual(cgm.glucoseValueHUD.glucoseLabel.font, originalFont)
+            XCTAssertEqual(hud.containerView.spacing, originalSpacing)
+        }
+    }
+
+    @MainActor
+    func testGlanceLayoutAtPhoneWidths() {
+        for width in [CGFloat(320), 390, 430] {
+            let hud = StatusBarHUDView(frame: CGRect(x: 0, y: 0, width: width, height: 74))
+            hud.cgmStatusHUD.glucoseValueHUD.glucoseLabel.text = "112"
+            hud.cgmStatusHUD.glucoseValueHUD.unitLabel.text = "mg/dL"
+            hud.setGlanceLayout(true)
+            let size = hud.systemLayoutSizeFitting(CGSize(width: width, height: 0),
+                withHorizontalFittingPriority: .required, verticalFittingPriority: .fittingSizeLevel)
+            hud.frame.size = size
+            hud.layoutIfNeeded()
+            XCTAssertGreaterThan(size.height, 150)
+            XCTAssertEqual(size.width, width, accuracy: 1)
+            let label = hud.cgmStatusHUD.glucoseValueHUD.glucoseLabel!
+            let labelRect = label.convert(label.bounds, to: hud)
+            XCTAssertGreaterThanOrEqual(labelRect.minX, 0)
+            XCTAssertLessThanOrEqual(labelRect.maxX, width)
+            let renderer = UIGraphicsImageRenderer(size: size)
+            let image = renderer.image { hud.layer.render(in: $0.cgContext) }
+            let attachment = XCTAttachment(image: image)
+            attachment.name = "Glance-HUD-\(Int(width))"
+            attachment.lifetime = .keepAlways
+            add(attachment)
+        }
+    }
+}
 
 extension XCTestCase {
     
diff --git a/Loop/LoopUI/Views/StatusBarHUDView.swift b/Loop/LoopUI/Views/StatusBarHUDView.swift
index 3bd851e..cf5fa85 100644
--- a/Loop/LoopUI/Views/StatusBarHUDView.swift
+++ b/Loop/LoopUI/Views/StatusBarHUDView.swift
@@ -18,13 +18,73 @@ public class StatusBarHUDView: UIView, NibLoadable {
     @IBOutlet public weak var pumpStatusHUD: PumpStatusHUDView!
         
     public var containerView: UIStackView!
+
+    private var glanceStatusRow: UIStackView?
+    private var glanceConstraints: [NSLayoutConstraint] = []
+    private var originalGlucoseFont: UIFont?
+    private var isGlanceLayout = false
+
+    /// Rearranges the existing HUD views, retaining their warning, staleness,
+    /// accessibility and tap behavior. Does not create another glucose data path.
+    public func setGlanceLayout(_ enabled: Bool) {
+        guard enabled != isGlanceLayout else { return }
+        isGlanceLayout = enabled
+        let glucoseLabel = cgmStatusHUD.glucoseValueHUD.glucoseLabel!
+        if originalGlucoseFont == nil { originalGlucoseFont = glucoseLabel.font }
+
+        // Retain the views while moving them because the outlets are weak.
+        let cgm = cgmStatusHUD!
+        let loop = loopCompletionHUD!
+        let pump = pumpStatusHUD!
+        NSLayoutConstraint.deactivate(glanceConstraints)
+        glanceConstraints = []
+        for view in containerView.arrangedSubviews {
+            containerView.removeArrangedSubview(view)
+            view.removeFromSuperview()
+        }
+        if let row = glanceStatusRow {
+            for view in row.arrangedSubviews {
+                row.removeArrangedSubview(view)
+                view.removeFromSuperview()
+            }
+        }
+        glanceStatusRow = nil
+
+        if enabled {
+            containerView.axis = .vertical
+            containerView.spacing = 4
+            let row = UIStackView(arrangedSubviews: [loop, pump])
+            row.axis = .horizontal
+            row.spacing = 16
+            containerView.addArrangedSubview(cgm)
+            containerView.addArrangedSubview(row)
+            glanceStatusRow = row
+            glucoseLabel.font = UIFontMetrics(forTextStyle: .largeTitle).scaledFont(
+                for: .systemFont(ofSize: 54, weight: .heavy), maximumPointSize: 68)
+            glanceConstraints = [
+                cgm.glucoseValueHUD.heightAnchor.constraint(greaterThanOrEqualToConstant: 92),
+                row.heightAnchor.constraint(greaterThanOrEqualToConstant: 74)
+            ]
+            NSLayoutConstraint.activate(glanceConstraints)
+        } else {
+            containerView.axis = .horizontal
+            containerView.spacing = adjustViewsForNarrowDisplay ? 8 : 16
+            containerView.addArrangedSubview(cgm)
+            containerView.addArrangedSubview(loop)
+            containerView.addArrangedSubview(pump)
+            glucoseLabel.font = originalGlucoseFont
+        }
+        setNeedsLayout()
+        invalidateIntrinsicContentSize()
+    }
+
     
     public var adjustViewsForNarrowDisplay: Bool = false {
         didSet {
             if adjustViewsForNarrowDisplay != oldValue {
                 cgmStatusHUD.adjustViewsForNarrowDisplay = adjustViewsForNarrowDisplay
                 pumpStatusHUD.adjustViewsForNarrowDisplay = adjustViewsForNarrowDisplay
-                containerView.spacing = adjustViewsForNarrowDisplay ? 8.0 : 16.0
+                containerView.spacing = isGlanceLayout ? 4 : (adjustViewsForNarrowDisplay ? 8.0 : 16.0)
             }
         }
     }
