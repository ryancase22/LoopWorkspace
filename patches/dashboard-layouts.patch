+    static var dashboard: ChartColorPalette {
+        let stock = ChartColorPalette.primary
+        return ChartColorPalette(
+            axisLine: stock.axisLine,
+            axisLabel: UIColor { traits in
+                let color: UIColor = DashboardLayout.selected == .original ? stock.axisLabel : .label
+                return color.resolvedColor(with: traits)
+            },
+            grid: UIColor { traits in
+                let color = stock.grid.resolvedColor(with: traits)
