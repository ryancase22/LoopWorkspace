+
+// Local presentation preference only; deliberately separate from therapy settings.
+enum DashboardLayout: String, CaseIterable {
+    case original, glance, graphFirst, compact, aurora, telemetry, zenith
+
+    static let preferenceKey = "com.ryancase.loop.dashboardLayout.v1"
+
+    static var selected: DashboardLayout {
+        DashboardLayout(rawValue: UserDefaults.standard.string(forKey: preferenceKey) ?? "") ?? .original
+    }
+
+    // Allocate one finite viewport budget. Do not independently clamp each row,
+    // which made the previous cards taller than the screen in total.
+    func fittedChartHeights(availableHeight: CGFloat) -> [CGFloat] {
+        let weights: [CGFloat]
+        switch self {
+        case .original, .glance: weights = [0.40, 0.20, 0.20, 0.20]
+        case .graphFirst: weights = [0.46, 0.18, 0.18, 0.18]
+        case .compact: weights = [0.34, 0.22, 0.22, 0.22]
+        case .aurora: weights = [0.37, 0.21, 0.21, 0.21]
+        case .telemetry: weights = [0.32, 0.24, 0.26, 0.18]
+        case .zenith: weights = [0.40, 0.20, 0.20, 0.20]
+        }
+        let budget = max(0, availableHeight)
+        let first = weights.prefix(3).map { floor(budget * $0) }
+        return first + [max(0, budget - first.reduce(0, +))]
+    }
+
+    var presentation: DashboardPresentation {
+        switch self {
+        case .original: return .original
+        case .glance: return .orbit
+        case .graphFirst: return .missionControl
+        case .compact: return .eclipse
+        case .aurora: return .aurora
+        case .telemetry: return .telemetry
+        case .zenith: return .zenith
+        }
+    }
+
+    var title: String {
+        switch self {
+        case .original: return "Original Loop"
+        case .glance: return "Everyday cards"
+        case .graphFirst: return "Glucose focus"
+        case .compact: return "Simple cards"
+        case .aurora: return "Compact cards"
+        case .telemetry: return "Insulin focus"
+        case .zenith: return "Large numbers"
+        }
+    }
+
+    var detail: String {
+        switch self {
+        case .original: return "The standard Loop dashboard."
+        case .glance: return "Balanced cards."
+        case .graphFirst: return "Larger glucose graph."
+        case .compact: return "Minimal cards."
+        case .aurora: return "Compact cards."
+        case .telemetry: return "Larger insulin graphs."
+        case .zenith: return "Larger glucose number."
+        }
+    }
+}
