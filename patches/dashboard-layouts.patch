+class LoopTests: XCTestCase {
+    func testDashboardPreferenceDefaultsAndRoundTrip() {
+        let defaults = UserDefaults.standard
+        let key = DashboardLayout.preferenceKey
+        let previous = defaults.object(forKey: key)
+        defer {
+            if let previous = previous { defaults.set(previous, forKey: key) }
+            else { defaults.removeObject(forKey: key) }
+        }
+        defaults.removeObject(forKey: key)
+        XCTAssertEqual(DashboardLayout.selected, .original)
+        defaults.set("unknown-future-layout", forKey: key)
+        XCTAssertEqual(DashboardLayout.selected, .original)
+        for layout in DashboardLayout.allCases {
+            defaults.set(layout.rawValue, forKey: key)
+            XCTAssertEqual(DashboardLayout.selected, layout)
+        }
+    }
+
+    @MainActor
+    func testAllPresentationsRetainStaleReadingAndHUDIdentity() {
+        let hud = StatusBarHUDView(frame: CGRect(x: 0, y: 0, width: 390, height: 74))
+        let cgm = hud.cgmStatusHUD!
+        let loop = hud.loopCompletionHUD!
+        let pump = hud.pumpStatusHUD!
+        let originalFont = cgm.glucoseValueHUD.glucoseLabel.font
+        let originalBackground = hud.backgroundColor
+        let tap = UITapGestureRecognizer()
+        cgm.addGestureRecognizer(tap)
+        for unit in [HKUnit(from: "mg/dL"), HKUnit(from: "mmol/L")] {
+            cgm.setGlucoseQuantity(112, at: Date().addingTimeInterval(-3600), unit: unit,
+                                  staleGlucoseAge: 600, glucoseDisplay: nil,
+                                  wasUserEntered: false, isDisplayOnly: false)
+            let staleText = cgm.glucoseValueHUD.glucoseLabel.text
+            let accessibility = cgm.accessibilityValue
+            for _ in 0..<3 {
+                for layout in DashboardLayout.allCases {
+                    hud.setDashboardPresentation(layout.presentation)
+                    XCTAssertTrue(hud.cgmStatusHUD === cgm)
+                    XCTAssertTrue(hud.loopCompletionHUD === loop)
+                    XCTAssertTrue(hud.pumpStatusHUD === pump)
+                    XCTAssertEqual(cgm.glucoseValueHUD.glucoseLabel.text, staleText)
+                    XCTAssertEqual(cgm.accessibilityValue, accessibility)
+                    XCTAssertTrue(cgm.gestureRecognizers?.contains(tap) == true)
+                }
+            }
+        }
+        hud.setDashboardPresentation(.original)
+        XCTAssertEqual(hud.containerView.axis, .horizontal)
