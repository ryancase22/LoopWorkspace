+    /// Preserve the native plot and its complete vertical space. No explanatory text.
+    func cardChart(withFrame frame: CGRect, render: (CGRect) -> UIView?) -> UIView? {
+        guard dashboardLayout != .original else { return render(frame) }
+        let inset: CGFloat = 10
+        let plot = CGRect(x: 0, y: 0, width: max(0, frame.width - inset * 2), height: frame.height - 6)
+        guard let chart = render(plot) else { return nil }
+        let wrapper = UIView(frame: frame)
+        chart.frame.origin = CGPoint(x: inset, y: 0)
+        wrapper.addSubview(chart)
+        return wrapper
+    }
+
+    private var originalSectionHeaderPadding: CGFloat?
+    private var cardSectionChrome: CGFloat = 0
+    private var lastCardHeightBudget: CGFloat?
